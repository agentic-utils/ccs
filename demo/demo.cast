[31.576, "o", "\r\n               \u001b[90m\u001b[0m\u001b[0m\u001b[38;5;39m\u2502\u001b[0m   \u001b[33m^X B    \u001b[0m fold its branch to its own row (its counts stay)                                               \u001b[38;5;39m\u2502\u001b[0m\u001b[90m\u001b[0m\u001b[K\r\n               \u001b[90m\u001b[0m\u001b[0m\u001b[38;5;39m\u2502\u001b[0m   \u001b[33m^X S    \u001b[0m put it away: settle until its next message, or snooze it                                       \u001b[38;5;39m\u2502\u001b[0m\u001b[90m\u001b[0m\u001b[K\r\n               \u001b[90m\u001b[0m\u001b[0m\u001b[38;5;39m\u2502\u001b[0m   \u001b[33m^X F    \u001b[0m show its details under the summary line (or click the line)                                    \u001b[38;5;39m\u2502\u001b[0m\u001b[90m\u001b[0m\u001b[K\r\n               \u001b[90m\u001b[0m\u001b[0m\u001b[38;5;39m\u2502\u001b[0m   \u001b[33m^X X    \u001b[0m shrink its file, keeping the dialogue; asks first, loses /rewind                               \u001b[38;5;39m\u2502\u001b[0m\u001b[90m\u001b[0m\u001b[K\r\n               \u001b[90m\u001b[0m\u001b[0m\u001b[38;5;39m\u2502\u001b[0m   \u001b[33m^X K    \u001b[0m stop this session and close its tab; asks first                                                \u001b[38;5;39m\u2502\u001b[0m\u001b[90m\u001b[0m\u001b[K\r\n               \u001b[90m\u001b[0m\u001b[0m\u001b[38;5;39m\u2502\u001b[0m   \u001b[33m^X R    \u001b"]
[31.576, "o", "[0m restart it: stop, then resume this conversation in a new tab with the same flags; asks first   \u001b[38;5;39m\u2502\u001b[0m\u001b[90m\u001b[0m\u001b[K\r\n               \u001b[90m\u001b[0m\u001b[0m\u001b[38;5;39m\u2502\u001b[0m   \u001b[33m^X D    \u001b[0m delete its transcript file; asks first, can't be undone                                        \u001b[38;5;39m\u2502\u001b[0m\u001b[90m\u001b[0m\u001b[K\r\n               \u001b[90m\u001b[0m\u001b[0m\u001b[38;5;39m\u2502\u001b[0m                                                                                                           \u001b[38;5;39m\u2502\u001b[0m\u001b[90m\u001b[0m\u001b[K\r\n               \u001b[90m\u001b[0m\u001b[0m\u001b[38;5;39m\u2502\u001b[0m   \u001b[90m^X then a letter: view and tools\u001b[0m                                                                        \u001b[38;5;39m\u2502\u001b[0m\u001b[90m\u001b[0m\u001b[K\r\n               \u001b[90m\u001b[0m\u001b[0m\u001b[38;5;39m\u2502\u001b[0m   \u001b[33m^X W    \u001b[0m sessions waiting on you: answer, open or snooze them                                           \u001b[38;5;39m\u2502\u001b[0m\u001b[90m\u001b[0m\u001b[K\r\n               \u001b[90m\u001b[0m\u001b[0m\u001b[38;5;39m\u2502\u001b[0m   \u001b[33m^X G    \u001b[0m group the list by folder                                             "]
[31.576, "o", "                          \u001b[38;5;39m\u2502\u001b[0m\u001b[90m\u001b[0m\u001b[K\r\n               \u001b[90m\u001b[0m\u001b[0m\u001b[38;5;39m\u2502\u001b[0m   \u001b[33m^X T    \u001b[0m the full table, every column                                                                   \u001b[38;5;39m\u2502\u001b[0m\u001b[90m\u001b[0m\u001b[K\r\n               \u001b[90m\u001b[0m\u001b[0m\u001b[38;5;39m\u2502\u001b[0m   \u001b[33m^X L    \u001b[0m hide the list, the preview taking the whole width (\u2191\u2193 still move)                              \u001b[38;5;39m\u2502\u001b[0m\u001b[90m\u001b[0m\u001b[K\r\n               \u001b[90m\u001b[0m\u001b[0m\u001b[38;5;39m\u2502\u001b[0m   \u001b[33m^X C    \u001b[0m hide the coordinator: its row, and the offer to set one up                                     \u001b[38;5;39m\u2502\u001b[0m\u001b[90m\u001b[0m\u001b[K\r\n               \u001b[90m\u001b[0m\u001b[0m\u001b[38;5;39m\u2502\u001b[0m   \u001b[33m^X H    \u001b[0m show headless runs (claude -p, codex exec)                                                     \u001b[38;5;39m\u2502\u001b[0m\u001b[90m\u001b[0m\u001b[K\r\n               \u001b[90m\u001b[0m\u001b[0m\u001b[38;5;39m\u2502\u001b[0m   \u001b[33m^X A    \u001b[0m switch to a session's tab when it starts waiting on you                                        \u001b[38;5;39m\u2502\u001b[0m\u001b[90m\u001b[0m\u001b[K\r\n   "]
