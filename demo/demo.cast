[27.615, "o", "://github.com/example/payments-api/actions/runs/4121\u001b\\api/actions/runs/4121\u001b]8;;\u001b\\)\u001b[39m.\u001b[0m\u001b[K\r\n\n                                  \u001b[90m\u2502\u001b[0m\u001b[90m  ... 1 messages ...\u001b[0m\u001b[K\r\n\n                                  \u001b[90m\u2502\u001b[0m\u25cf Done:\u001b[K\r\n\n                                  \u001b[90m\u2502\u001b[0m  - sorted line items in \u001b[36mcheckout.total()\u001b[39m\u001b[0m\u001b[K\r\n                                  \u001b[90m\u2502\u001b[0m  - added a regression test that shuffles the input 100 times\u001b[K\r\n\n                                  \u001b[90m\u2502\u001b[0m  \u001b[36mdef total(items):\u001b[39m\u001b[0m\u001b[K\r\n                                  \u001b[90m\u2502\u001b[0m  \u001b[36m    return sum(i.price for i in sorted(items, key=lambda i: i.sku))\u001b[39m\u001b[0m\u001b[K\r\n\n                                  \u001b[90m\u2502\u001b[0m  PR: \u001b[4m\u001b]8;;https://github.com/example/payments-api/pull/812\u001b\\github.com/example/payments-api/pull/812\u001b]8;;\u001b\\\u001b[24m\u001b[0m\u001b[K\r\n\n                                  \u001b[90m\u2502\u001b[0m\u001b[1m\u25b6\u001b[22m CI is green on #812, so the \u001b[43;30mfla\u001b[49;39mky test is fixed and the PR is ready to merge.\u001b[0m\u001b[K\r\n\n\n\n\n\n\n\n\u001b[40"]
