[23.033, "o", "\u2503\u001b[0m\u001b[K\r\n \u001b[90m\u001b[0m    \u001b[90m1d \u00b7 58k ctx \u00b7 payments...\u001b[0m \u001b[38;5;141m+1\u001b[0m\u001b[90m\u2502\u001b[0m\u001b[0m                                                                                                       \u001b[37m\u2503\u001b[0m\u001b[K\r\n   \u001b[38;5;173m\u273b\u001b[0m \u001b[90mNightly export size\u001b[0m          \u001b[90m\u2502\u001b[0m  - sorted line items in \u001b[36mcheckout.total()\u001b[39m\u001b[0m\u001b[0m                                                              \u001b[37m\u2503\u001b[0m\u001b[K\r\n \u001b[90m\u001b[0m    \u001b[90m3d \u00b7 730k ctx \u00b7 data        \u001b[0m \u001b[90m\u2502\u001b[0m  - added a regression test that shuffles the input 100 times\u001b[0m                                          \u001b[37m\u2503\u001b[0m\u001b[K\r\n\n                                  \u001b[90m\u2502\u001b[0m  \u001b[36mdef total(items):\u001b[39m\u001b[0m\u001b[0m                                                                                    \u001b[37m\u2503\u001b[0m\u001b[K\r\n                                  \u001b[90m\u2502\u001b[0m  \u001b[36m    return sum(i.price for i in sorted(items, key=lambda i: i.sku))\u001b[39m\u001b[0m\u001b[0m                                  \u001b[37m\u2503\u001b[0m\u001b[K\r\n\n                                  \u001b[9"]
