[24.876, "o", "\u001b[H\n  > \u001b[7mt\u001b[0m\u001b[38;5;240mype to search...\u001b[0m\u001b[38;5;240m                        \u001b[0m                                            \u001b[90myou@example.com\u001b[0m \u001b[90m\u00b7\u001b[0m \u001b[33mopen claude to see usage\u001b[0m   \u001b[90m(7/7)\u001b[0m\u001b[K\r\n\n  \u001b[1;37mcoordinator\u001b[0m \u001b[90m1\u001b[0m                   \u001b[90m\u2502\u001b[0m\u001b[90m\u25b8\u001b[0m coordinator \u001b[90m\u00b7\u001b[0m coordinator \u001b[90m\u00b7\u001b[0m opus 5.5 \u001b[90m\u00b7\u001b[0m \u001b[32m6%\u001b[0m ctx \u001b[90m\u00b7\u001b[0m 1KB \u00b7 2 msgs \u001b[90m^X D\u001b[0m\u001b[0m\u001b[K\r\n\u001b[1;38;5;230;48;5;62m  \u25cf\u273b coordinator \u270e                \u001b[0m\u001b[90m\u2502\u001b[0m\u001b[K\r\n\u001b[1;38;5;230;48;5;62m     1m \u00b7 64k ctx \u00b7 coordinator   \u001b[0m\u001b[90m\u2502\u001b[0m\u001b[K\r\n  \u001b[1;38;5;201mwaiting on you\u001b[0m \u001b[90m1\u001b[0m                \u001b[90m\u2502\u001b[0m\u001b[K\r\n   \u001b[38;5;173m\u273b\u001b[0m mobile-settings \u270e            \u001b[90m\u2502\u001b[0m\u001b[K\r\n     \u001b[90m2m \u00b7 41k ctx \u00b7 web        \u001b[0m \u001b[31m\u27171\u001b[0m\u001b[90m\u2502\u001b[0m\u001b[K\r\n  \u001b[32midle\u001b[0m \u001b[90m1\u001b[0m                          \u001b[90m\u2502\u001b[0m\u001b[K\r\n   \u001b[38;5;173m\u273b\u001b[0m fix-flaky-checkout \u270e         \u001b[90m\u2502\u001b[0m\u001b[K\r\n     \u001b[90m4m \u00b7 212k ctx \u00b7 paym...\u001b[0m \u001b[32m\u27131\u001b[0m \u001b[38;5;141m\u25cf1"]
[24.876, "o", "\u001b[0m\u001b[90m\u2502\u001b[0m\u001b[K\r\n  \u001b[38;5;214mbusy\u001b[0m \u001b[90m1\u001b[0m                          \u001b[90m\u2502\u001b[0m\u001b[K\r\n   \u001b[38;5;173m\u273b\u001b[0m staging-deploy-timeout \u270e     \u001b[90m\u2502\u001b[0m\u001b[K\r\n     \u001b[90m6m \u00b7 95k ctx \u00b7 infra       \u001b[0m \u001b[38;5;214m1\u001b[0m\u001b[90m\u2502\u001b[0m\u001b[K\r\n  \u001b[90mnot open in claude\u001b[0m \u001b[90m3\u001b[0m            \u001b[90m\u2502\u001b[0m\u001b[K\r\n   \u001b[38;5;173m\u273b\u001b[0m Webhook retries              \u001b[90m\u2502\u001b[0m\u001b[K\r\n     \u001b[90m1d \u00b7 58k ctx \u00b7 payments...\u001b[0m \u001b[38;5;141m\u25cf1\u001b[0m\u001b[90m\u2502\u001b[0m\u001b[K\r\n   \u001b[38;5;173m\u273b\u001b[0m Nightly export size          \u001b[90m\u2502\u001b[0m\u001b[K\r\n     \u001b[90m3d \u00b7 730k ctx \u00b7 data        \u001b[0m \u001b[90m\u2502\u001b[0m\u001b[K\r\n   \u001b[38;5;173m\u273b\u001b[0m Rotate staging keys          \u001b[90m\u2502\u001b[0m\u001b[K\r\n     \u001b[90m6d \u00b7 33k ctx \u00b7 infra        \u001b[0m \u001b[90m\u2502\u001b[0m\u001b[K\r\n\n                                  \u001b[90m\u2502\u001b[0m\u001b[K\r\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n                                  \u001b[90m\u2502\u001b[0m\u001b[38;5;240m\u2502\u001b[0m\u203a \u001b[38;5;240mm\u001b[0m\u001b[38;5;240message coordinator\u2026\u001b[0m\u001b[38;5;240m                                                                             \u001b[0m   \u001b[38;5;240m\u2502\u001b[0m\u001b[K\r\n\u001b"]
