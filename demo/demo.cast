[11.077, "o", "\u001b[H\n\n\n   \u001b[38;5;173m\u273b\u001b[0m \u25be coordinator                \u001b[90m\u2502\u001b[0m\u001b[90m\u25b8\u001b[0m fix-flaky-checkout \u001b[90m\u00b7\u001b[0m payments-api \u001b[90m\u00b7\u001b[0m opus 5.5 1M \u001b[90m\u00b7\u001b[0m \u001b[33m21%\u001b[0m ctx \u001b[90m\u00b7\u001b[0m PRs \u001b[32m\u27131\u001b[0m \u001b[90m\u00b7\u001b[0m 3KB \u00b7 6 msgs\u001b[0m    \u001b[90mTue 17 Nov 22:41\u001b[0m\u001b[K\r\n\n   \u001b[38;5;173m\u273b\u001b[0m   \u251c \u001b[38;5;201mmobile-settings\u001b[0m         \u001b[38;5;201m?\u001b[0m\u001b[90m\u2502\u001b[0m\u001b[48;5;237;38;5;252m\u276f the checkout test is flaky on CI, can you find out why?                                              \u001b[0m\u001b[K\r\n\n   \u001b[38;5;173m\u273b\u001b[0m   \u2514 \u001b[38;5;214mstaging-deploy-timeout\u001b[0m   \u001b[90m\u2502\u001b[0m\u25cf Found it. \u001b[36mtest_checkout_total\u001b[39m depends on the \u001b[1morder of a dict\u001b[22m built from a set, so it passes or fails\u001b[0m\u001b[K\r\n                                  \u001b[90m\u2502\u001b[0m  \u001b[36m\u001b[39m\u001b[1m\u001b[22mat random.\u001b[0m\u001b[K\r\n\n   \u001b[38;5;173m\u273b\u001b[0m \u001b[90mWebhook retries\u001b[0m              \u001b[90m\u2502\u001b[0m  \u001b[1mrun  \u001b[22m \u001b[90m\u2502\u001b[39m \u001b[1mresult\u001b[22m \u001b[90m\u2502\u001b[39m \u001b[1morder\u001b[22m\u001b[K\r\n     \u001b[90m1d \u00b7 58k ctx \u00b7 payments-api \u001b[0m \u001b[90m\u2502\u001b[0m  \u001b[90m\u2500"]
[11.077, "o", "\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m\u001b[K\r\n   \u001b[38;5;173m\u273b\u001b[0m \u001b[90mNightly export size\u001b[0m          \u001b[90m\u2502\u001b[0m  #4120 \u001b[90m\u2502\u001b[39m pass   \u001b[90m\u2502\u001b[39m a, b \u001b[K\r\n     \u001b[90m3d \u00b7 730k ctx \u00b7 data        \u001b[0m \u001b[90m\u2502\u001b[0m  #4121 \u001b[90m\u2502\u001b[39m fail   \u001b[90m\u2502\u001b[39m b, a \u001b[K\r\n   \u001b[38;5;173m\u273b\u001b[0m \u001b[90mRotate staging keys\u001b[0m          \u001b[90m\u2502\u001b[0m  #4122 \u001b[90m\u2502\u001b[39m pass   \u001b[90m\u2502\u001b[39m a, b \u001b[K\r\n\n                                  \u001b[90m\u2502\u001b[0m  Fix: sort the line items before summing. See \u001b[4m\u001b]8;;https://github.com/example/payments-api/actions/runs/4121\u001b\\the\u001b]8;;\u001b\\ \u001b]8;;https://github.com/example/payments-api/actions/runs/4121\u001b\\failing\u001b]8;;\u001b\\ \u001b]8;;https://github.com/example/payments-api/actions/runs/4121\u001b\\run\u001b]8;;\u001b\\\u001b[24m \u001b[90m(\u001b]8;;https://github.com/example/payments-api/actions/runs/4121\u001b\\github.com/example/payments-\u001b]8;;\u001b\\\u001b[0m\u001b[K\r\n                                  \u001b[90m\u2502\u001b[0m  \u001b[4m\u001b[24m\u001b[90m\u001b]8;;https://github.com/example/payments-api/actions/runs/4121\u001b\\api/actions/runs/412"]
[11.077, "o", "1\u001b]8;;\u001b\\)\u001b[39m.\u001b[0m\u001b[K\r\n\n                                  \u001b[90m\u2502\u001b[0m\u001b[48;5;237;38;5;252m\u276f nice, fix it and open a PR                                                                           \u001b[0m\u001b[K\r\n\n                                  \u001b[90m\u2502\u001b[0m\u25cf Done:\u001b[K\r\n\n                                  \u001b[90m\u2502\u001b[0m  - sorted line items in \u001b[36mcheckout.total()\u001b[39m\u001b[0m\u001b[K\r\n                                  \u001b[90m\u2502\u001b[0m  - added a regression test that shuffles the input 100 times\u001b[K\r\n\n                                  \u001b[90m\u2502\u001b[0m  \u001b[36mdef total(items):\u001b[39m\u001b[0m\u001b[K\r\n                                  \u001b[90m\u2502\u001b[0m  \u001b[36m    return sum(i.price for i in sorted(items, key=lambda i: i.sku))\u001b[39m\u001b[0m\u001b[K\r\n\n                                  \u001b[90m\u2502\u001b[0m  PR: \u001b[4m\u001b]8;;https://github.com/example/payments-api/pull/812\u001b\\github.com/example/payments-api/pull/812\u001b]8;;\u001b\\\u001b[24m\u001b[0m\u001b[K\r\n\n                                  \u001b[90m\u2502\u001b[0m\u001b[90m  \u25b8 task-notification \u00b7 CI on #812 passed\u001b[0m\u001b[K\r\n\n                                  \u001b[90m"]
