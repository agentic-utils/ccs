[26.36, "o", "\u001b[H\n\n\n   \u001b[38;5;173m\u273b\u001b[0m \u25be coordinator              \u001b[36m\u23152\u001b[0m\u001b[90m\u2502\u001b[0m\u001b[90m\u25b8\u001b[0m fix-\u001b[43;30mfla\u001b[49;39mky-checkout \u001b[90m\u00b7\u001b[0m payments-api \u001b[90m\u00b7\u001b[0m opus 5.5 1M \u001b[90m\u00b7\u001b[0m \u001b[33m21%\u001b[0m ctx \u001b[90m\u00b7\u001b[0m PRs \u001b[32m\u27131\u001b[0m \u001b[90m\u00b7\u001b[0m 3KB \u00b7 6 msgs\u001b[0m    \u001b[90mTue 17 Nov 22:41\u001b[0m\u001b[K\r\n       \u001b[90m1m \u00b7 64k ctx              \u001b[0m \u001b[90m\u2502\u001b[0m  \u001b[90mhit 1/2 \u00b7 ^] next ^\\ prev\u001b[0m\u001b[K\r\n\u001b[1;38;5;230;48;5;62m   \u273b   \u2514 fix-flaky-checkout     \u23152\u001b[0m\u001b[90m\u2502\u001b[0m\u001b[48;5;237;38;5;252m\u001b[1m\u25b6\u001b[22m the checkout test is \u001b[43;30mfla\u001b[49;39m\u001b[48;5;237;38;5;252mky on CI, can you find out why?\u001b[0m\u001b[48;5;237;38;5;252m                                              \u001b[0m\u001b[K\r\n\n                                  \u001b[90m\u2502\u001b[0m\u25cf Found it. \u001b[36mtest_checkout_total\u001b[39m depends on the \u001b[1morder of a dict\u001b[22m built from a set, so it passes or fails\u001b[0m\u001b[K\r\n                                  \u001b[90m\u2502\u001b[0m  \u001b[36m\u001b[39m\u001b[1m\u001b[22mat random.\u001b[0m\u001b[K\r\n\n                                  \u001b[90m\u2502\u001b[0m  \u001b[1mrun  \u001b[22m \u001b[90m\u2502\u001b[39m \u001b["]
